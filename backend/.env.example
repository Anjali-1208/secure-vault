# Copy this file to .env and fill in real values before running the server

# MongoDB connection string. For local MongoDB: mongodb://127.0.0.1:27017/secure-vault
# For MongoDB Atlas (free cloud tier): mongodb+srv://<user>:<password>@cluster.mongodb.net/secure-vault
MONGO_URI=mongodb://127.0.0.1:27017/secure-vault

# Secret used to sign JWT tokens. Use a long random string in real deployments.
JWT_SECRET=replace_this_with_a_long_random_string

# How long a login token stays valid
JWT_EXPIRES_IN=2h

# Must be exactly 32 characters (256 bits) - used for AES-256 file encryption
ENCRYPTION_KEY=32_char_long_secret_key_change!

# Port the backend server runs on
PORT=5000

# How many failed logins before an account is temporarily locked
MAX_LOGIN_ATTEMPTS=5

# Lock duration in minutes after too many failed logins
LOCK_TIME_MINUTES=15
